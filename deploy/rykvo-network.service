[Unit]
# Rykvo Voice: per-network routing
Description=Rykvo Voice network routing
After=network.target systemd-resolved.service
Wants=network.target
Before=rykvo-auth.service

[Service]
Type=notify
NotifyAccess=main
Environment=PYTHONNOUSERSITE=1
ExecStartPre=/usr/bin/python3 /opt/rykvo-voice/live/network-control.py --cleanup
ExecStart=/usr/bin/python3 /opt/rykvo-voice/live/network-control.py
ExecStopPost=/usr/bin/python3 /opt/rykvo-voice/live/network-control.py --cleanup
StateDirectory=rykvo-network rykvo-network-route
StateDirectoryMode=0755
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
