# Rykvo Voice: isolated, typed SIP network operations.
[Unit]
Description=Rykvo Voice SIP network helper

[Service]
ExecStart=/usr/bin/python3 -I /opt/rykvo-voice/live/sip-network.py
StandardInput=socket
StandardOutput=socket
StandardError=null
RuntimeMaxSec=60
TimeoutStopSec=2
StateDirectory=rykvo-sip-network
StateDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
MemoryMax=64M
TasksMax=8
UMask=0077
