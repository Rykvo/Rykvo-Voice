[Unit]
Description=Rykvo Voice private host settings

[Service]
ExecStart=/usr/bin/python3 -I /opt/rykvo-voice/live/host-settings.py
StandardInput=socket
StandardOutput=socket
StandardError=null
RuntimeMaxSec=15
TimeoutStopSec=8
RuntimeDirectory=rykvo-hostname
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/hosts /etc/systemd/network -/etc/cloud/cloud.cfg.d -/run/systemd/network
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
MemoryMax=64M
TasksMax=8
UMask=0077
